      "source": [
        "def estimate_budget_allocation(total_budget):\n",
        "    \"\"\"Return a 40/40/remainder split whose integer parts sum exactly.\"\"\"\n",
        "    if total_budget < 0:\n",
        "        raise ValueError('total_budget must be non-negative')\n",
        "    exploration = int(0.4 * total_budget)\n",
        "    exploitation = int(0.4 * total_budget)\n",
        "    combination = total_budget - exploration - exploitation\n",
        "    return {\n",
        "        'exploration': exploration,\n",
        "        'exploitation': exploitation,\n",
        "        'combination': combination,\n",
        "    }\n",
        "\n",
        "allocation = estimate_budget_allocation(query_budget)\n",
        "print('Query budget allocation:', allocation)\n",
        "print('Allocated total:', sum(allocation.values()), '/', query_budget)\n",
        "\n",
        "# Make shuffled working copies, preserving the source series and ranked list.\n",
        "rng = np.random.default_rng(SEED)\n",
